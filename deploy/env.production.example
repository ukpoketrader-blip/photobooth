# Copy to repo root as .env before: docker compose -f docker-compose.prod.yml up -d --build
# cp deploy/env.production.example .env

# --- Domains (used by Caddy + public URLs) ---
BOOTH_DOMAIN=booth.yourdomain.com
ADMIN_DOMAIN=admin.yourdomain.com
API_DOMAIN=api.yourdomain.com

NEXT_PUBLIC_BOOTH_URL=https://booth.yourdomain.com
NEXT_PUBLIC_ADMIN_URL=https://admin.yourdomain.com
# Public API base (file URLs, webhooks)
API_URL=https://api.yourdomain.com
# Leave empty so booth/admin browsers use same-origin /api via Next rewrites
NEXT_PUBLIC_API_URL=

# --- Postgres (docker-compose service) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=photobooth
DATABASE_URL=postgresql://postgres:change-me-strong-password@postgres:5432/photobooth?schema=public

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Auth (generate with: openssl rand -base64 32) ---
AUTH_SECRET=
BOOTH_JWT_SECRET=
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change-me-before-sharing

# --- Google AI (required for demos with AI) ---
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview

# --- Storage (local volume on VPS — fine for test) ---
STORAGE_LOCAL_PATH=/data/uploads
GCS_BUCKET=
GCS_PROJECT_ID=

# --- Optional SumUp ---
SUMUP_API_BASE=https://api.sumup.com
SUMUP_CLIENT_ID=
SUMUP_CLIENT_SECRET=
SUMUP_WEBHOOK_SECRET=
SUMUP_MERCHANT_CODE=

# --- App ---
NODE_ENV=production
DATA_REGION=EU/UK
DEFAULT_RETENTION_DAYS=7
API_PORT=3002

# Caddy ACME email (Let's Encrypt)
ACME_EMAIL=you@yourdomain.com
