{
  "name": "photobooth",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "db:generate": "pnpm --filter @photobooth/db exec prisma generate",
    "db:migrate": "pnpm --filter @photobooth/db exec prisma migrate dev",
    "db:push": "pnpm --filter @photobooth/db exec prisma db push",
    "db:seed": "pnpm --filter @photobooth/db exec tsx prisma/seed.ts",
    "admin:set-password": "pnpm --filter @photobooth/db exec tsx ../../scripts/set-admin-password.ts",
    "worker": "pnpm --filter @photobooth/worker dev",
    "purge": "pnpm --filter @photobooth/worker purge"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "prisma": {
    "schema": "packages/db/prisma/schema.prisma"
  }
}
