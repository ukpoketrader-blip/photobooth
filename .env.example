# Database (EU region recommended)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/photobooth?schema=public"

# Redis (EU region recommended)
REDIS_URL="redis://localhost:6379"

# App URLs
NEXT_PUBLIC_BOOTH_URL="http://localhost:3000"
NEXT_PUBLIC_ADMIN_URL="http://localhost:3001"
API_URL="http://localhost:3002"

# Auth (admin)
AUTH_SECRET="generate-with-openssl-rand-base64-32"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="changeme"

# Booth instance signing
BOOTH_JWT_SECRET="generate-with-openssl-rand-base64-32"

# Optional: password before guests can use the kiosk (API only — not exposed to browser)
# Leave empty to disable. Set on Railway api service while demoing publicly.
BOOTH_ACCESS_PASSWORD=""

# Google AI Studio — https://aistudio.google.com/apikey
# Paste your key below, then restart API + worker terminals.
GEMINI_API_KEY=""
# Image-capable model (check AI Studio "Model" dropdown for latest image preview name)
GEMINI_IMAGE_MODEL="gemini-3-pro-image-preview"

# Print output: 6×4 inch portrait @ 300 DPI (dye-sub)
PRINT_DPI=300

# Local storage (dev) — path relative to repo root; API + worker must match
STORAGE_LOCAL_PATH="apps/api/uploads"

# GCS (europe-west2) — leave empty for local filesystem storage
GCS_BUCKET=""
GCS_PROJECT_ID=""
GOOGLE_APPLICATION_CREDENTIALS=""

# SumUp (optional)
SUMUP_API_BASE="https://api.sumup.com"
SUMUP_CLIENT_ID=""
SUMUP_CLIENT_SECRET=""
SUMUP_WEBHOOK_SECRET=""
SUMUP_MERCHANT_CODE=""

# GDPR defaults
DEFAULT_RETENTION_DAYS=7
PAYMENT_UNLOCK_TTL_MINUTES=15
SIGNED_URL_TTL_SECONDS=300

# Data region label (display only)
DATA_REGION="EU/UK"
